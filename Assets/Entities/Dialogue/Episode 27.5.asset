    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I'm not sure what to do with that and I dont think she
        is either
    - languageEnum: 1
      LanguageGenericType: "\u4F55\u3092\u3084\u3063\u3066\u3082\u308F\u304B\u3089\u306A\u3044\u3057\u3001\u81EA\u5206\u304C\u3069\u3061\u3089\u306A\u306E\u304B\u306F\u308F\u304B\u3089\u306A\u3044"
