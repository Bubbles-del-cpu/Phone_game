    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Babe I could not see a single thing from down there
    - languageEnum: 1
      LanguageGenericType: "\u30D9\u30A4\u30D6 \u79C1\u306F\u305D\u3053\u306B\u30C0\u30A6\u30F3\u304B\u3089\u5358\u4E00\u306E\u3082\u306E\u3092\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u305B\u3093"
