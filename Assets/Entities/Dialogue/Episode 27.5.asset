    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: All I was seeing was Sems pubes coming closer to me everytime
        he pushed
    - languageEnum: 1
      LanguageGenericType: "\u79C1\u304C\u898B\u3066\u3044\u305F\u306E\u306F\u3001Sems\u306E\u30D1\u30D6\u304C\u79C1\u306E\u6BCE\u56DE\u8FD1\u3065\u3044\u3066\u6765\u305F\u306E\u3067\u3057\u305F\u3002"
