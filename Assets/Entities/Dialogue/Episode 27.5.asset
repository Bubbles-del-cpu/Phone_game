      LanguageGenericType: "\u80CC\u4E2D\u3092\u8D8A\u3048\u308B\u3002 \u5951\u7D04\u3092\u9589\u3058\u308B2\u4EBA\u306E\u7537\u6027\u306E\u3088\u3046\u306B\u3002"
