    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: But I felt him lean right over me
    - languageEnum: 1
      LanguageGenericType: "\u3057\u304B\u3057\u3001\u79C1\u306F\u5F7C\u306B\u79C1\u306E\u4E0A\u3067\u53F3\u50BE\u304D\u3092\u611F\u3058\u305F"
