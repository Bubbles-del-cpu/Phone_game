  - NodeGuid: e307627d-6bb4-4d22-88cd-e7572f0461e8
    Position: {x: 34972, y: -552}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 14173166ace8e7b418d7ae1d1a0526b0, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: The waves were tossing that massive yacht around like
        it was a plastic toy. We had to bunker down in the captain's cabin for hours.
    - languageEnum: 1
      LanguageGenericType: "\u6CE2\u306F\u5DE8\u5927\u306A\u30E8\u30C3\u30C8\u3092
        \u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u88FD\u306E\u73A9\u5177\u306E\u3088\u3046\u306B
        \u6295\u3052\u56DE\u3063\u3066\u3044\u307E\u3057\u305F \u8239\u9577\u306E\u30AB\u30D3\u30F3\u306E\u9593\u306B
        \u4F55\u6642\u9593\u3082 \u6F5C\u308A\u8FBC\u307F\u307E\u3057\u305F"
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
      LanguageGenericType: 
    Timelapse: 
    Duration: 2
    Delay: 0
    MediaType: 0
    Image: {fileID: 0}
    Video: {fileID: 0}
    VideoThumbnail: {fileID: 0}
    NotBackgroundCapable: 0
    GalleryVisibility: 0
    Post: {fileID: 0}
    DelayTimer: 0
  - NodeGuid: 39cdd5ed-81e0-4ad7-ad77-958f6e94c8fb
    Position: {x: 35751, y: -680}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 14173166ace8e7b418d7ae1d1a0526b0, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I genuinely thought we were going down at one point.
    - languageEnum: 1
      LanguageGenericType: "\u672C\u5F53\u306F \u843D\u3061\u3066\u304F\u308B\u3093\u3060\u3068\u601D\u3063\u305F"
