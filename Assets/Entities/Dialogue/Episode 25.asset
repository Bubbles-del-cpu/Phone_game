    Position: {x: 58824, y: -585}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 14173166ace8e7b418d7ae1d1a0526b0, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Bro, the interior stairs to the lower deck are locked
        down by the crew.
    - languageEnum: 1
      LanguageGenericType: "\u968E\u306E\u968E\u6BB5\u306F \u4E57\u7D44\u54E1\u306B
        \u9375\u3092\u304B\u3051\u3089\u308C\u3066\u3044\u308B"
