    Character: {fileID: 11400000, guid: 14173166ace8e7b418d7ae1d1a0526b0, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Lisa said when the boat violently lurched, the crew yelled
        to get upstairs. Lisa ran for the stairs, but she thought Lily was right
        behind her.
    - languageEnum: 1
      LanguageGenericType: "\u30EA\u30B5\u306F\u30DC\u30FC\u30C8\u304C\u731B\u70C8\u306B\u6C88\u3093\u3060\u3068\u304D,\u4E57\u7D44\u54E1\u304C\u4E0A\u968E\u3092\u547C\u3093\u3060\u3068,\u30EA\u30B5\u306F\u968E\u6BB5\u3092\u8D70\u3063\u305F\u304C,\u30EA\u30EA\u30FC\u304C\u3059\u3050\u5F8C\u308D\u306B\u3044\u308B\u3068\u601D\u3063\u305F."
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
      LanguageGenericType: 
