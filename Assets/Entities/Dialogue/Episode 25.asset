    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Bro, I think she's still trapped below deck with the husband.
    - languageEnum: 1
      LanguageGenericType: "\u5144\u3055\u3093 \u5F7C\u5973\u306F\u592B\u3068\u30C7\u30C3\u30AD\u306E\u4E0B\u306B\u306F
