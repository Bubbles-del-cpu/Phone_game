    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: When everyone was rushing upstairs, I lost my balance.
    - languageEnum: 1
      LanguageGenericType: "\u307F\u3093\u306A\u6025\u3044\u3067\u4E0A\u968E\u3067
