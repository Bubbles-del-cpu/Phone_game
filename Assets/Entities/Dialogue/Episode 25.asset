    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Okay, I slipped out of the captain's cabin.
    - languageEnum: 1
      LanguageGenericType: "\u308F\u304B\u3063\u305F \u968A\u9577\u306E\u90E8\u5C4B\u304B\u3089\u629C\u3051\u51FA\u3057\u305F"
