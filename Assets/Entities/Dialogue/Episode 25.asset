    - languageEnum: 1
      LanguageGenericType: "\u5F7C\u306F\u79C1\u3092\u6355\u307E\u3048,\u62FE\u3063\u3066,\u3053\u306E\u5B89\u5168\u306A\u90E8\u5C4B\u306B\u9023\u308C\u3066\u884C\u304D\u307E\u3057\u305F."
