  - NodeGuid: c0ba6842-c29b-4bc0-a46a-418458007703
    Position: {x: 36101, y: -680}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 14173166ace8e7b418d7ae1d1a0526b0, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Totally killed the mood for the night. We barely made
        it back to the marina in one piece.
    - languageEnum: 1
      LanguageGenericType: "\u6C17\u5206\u306F\u6D88\u3048\u305F \u6E2F\u307E\u3067\u4E00\u7247\u3067\u623B\u3063\u305F"
