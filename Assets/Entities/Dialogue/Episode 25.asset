    Position: {x: 59174, y: -585}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 14173166ace8e7b418d7ae1d1a0526b0, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I couldn't get down there from the inside.
    - languageEnum: 1
      LanguageGenericType: "\u5185\u5074\u304B\u3089\u964D\u308A\u3066\u6765\u306A\u304B\u3063\u305F"
