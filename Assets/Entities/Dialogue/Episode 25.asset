  - NodeGuid: 73cdf8d0-a8e2-4227-8997-227383691d2b
    Position: {x: 92881, y: -565}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 7bd5d83a9443f8449b2f8346c4479558, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: We were already doing so much before the storm hit...
        I was already so worked up.
    - languageEnum: 1
      LanguageGenericType: "\u5D50\u304C\u8972\u3046\u524D\u306B \u6CA2\u5C71\u306E\u4E8B\u3092\u3057\u3066\u3044\u305F...
        \u79C1\u306F\u3082\u3046\u8208\u596E\u3057\u3066\u3044\u305F"
