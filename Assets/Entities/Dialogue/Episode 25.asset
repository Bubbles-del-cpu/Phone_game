  - NodeGuid: 5828f78d-003a-4f52-8404-55df2d01ca72
    Position: {x: 92567, y: -646}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 7bd5d83a9443f8449b2f8346c4479558, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: He grabbed my wrist.
    - languageEnum: 1
      LanguageGenericType: "\u5F7C\u306F\u79C1\u306E\u624B\u9996\u3092\u63B4\u3093\u3060."
    Timelapses:
    - languageEnum: 0
