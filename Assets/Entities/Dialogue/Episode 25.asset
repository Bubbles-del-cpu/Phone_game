  - NodeGuid: 15f45473-7415-4099-bbe1-31c990566f36
    Position: {x: 92230, y: -554}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 7bd5d83a9443f8449b2f8346c4479558, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I tried to follow her, but...
    - languageEnum: 1
      LanguageGenericType: "\u8FFD\u3044\u304B\u3051\u3066\u304D\u305F\u3051\u3069..."
