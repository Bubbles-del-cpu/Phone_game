    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I had to use the side hatch to get out onto the lower
        exterior walkway.
    - languageEnum: 1
      LanguageGenericType: "\u5074\u53E3\u3092\u4F7F\u3063\u3066 \u4E0B\u306E\u5916\u5074\u306E\u6B69\u9053\u306B
