  - NodeGuid: cf948ebf-6df4-4654-b0ce-3ddbfbcf4ed4
    Position: {x: 93464, y: -890}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 7bd5d83a9443f8449b2f8346c4479558, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: The fear of the storm is just mixing with how turned on
        I already was.
    - languageEnum: 1
      LanguageGenericType: "\u5D50\u306E\u6050\u6016\u306F \u8208\u596E\u3057\u305F\u72B6\u614B\u3068
