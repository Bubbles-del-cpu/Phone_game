    - languageEnum: 1
      LanguageGenericType: "\u30DF\u30A2\u3092\u63B4\u3093\u3060 \u30EA\u30EA\u30FC\u304C\u5F8C\u308D\u306B\u3044\u308B\u3068\u601D\u3063\u305F"
