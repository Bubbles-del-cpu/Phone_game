    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: We got back to the hotel a few hours ago. Lisa is completely
        out cold.
    - languageEnum: 1
      LanguageGenericType: "\u6570\u6642\u9593\u524D\u306B\u30DB\u30C6\u30EB\u306B\u623B\u3063\u305F
