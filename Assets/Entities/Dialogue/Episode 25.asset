    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: We're fine, but holy shit dude. It was terrifying.
    - languageEnum: 1
      LanguageGenericType: "\u308F\u304B\u3063\u305F \u3067\u3082 \u3072\u3069\u3044\u4E8B\u3060\u3063\u305F"
