    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Give me a minute. I'm going to wait for the captain to
        look the other way and slip out.
    - languageEnum: 1
      LanguageGenericType: "\u5F85\u3063\u3066 \u8266\u9577\u304C\u9006\u5411\u304D\u306B
        \u898B\u3066\u51FA\u3066\u304F\u308B"
