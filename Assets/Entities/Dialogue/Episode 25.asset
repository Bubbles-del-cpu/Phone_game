  - NodeGuid: 2a8da812-6ad2-4902-9781-55ed0f8ad374
    Position: {x: 34612, y: -512}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
