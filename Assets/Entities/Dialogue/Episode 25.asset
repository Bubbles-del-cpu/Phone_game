  - NodeGuid: 802fdbda-3acb-48d9-b86f-00437cf397a5
    Position: {x: 93168, y: -491}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 7bd5d83a9443f8449b2f8346c4479558, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: And then suddenly Lisa was gone, the heavy door was locked,
        and the boat started tossing everywhere.
    - languageEnum: 1
      LanguageGenericType: "\u7A81\u7136 \u30EA\u30B5\u304C\u6D88\u3048\u305F \u91CD\u3044\u30C9\u30A2\u304C\u30ED\u30C3\u30AF\u3055\u308C
        \u8239\u306F\u3069\u3053\u306B\u3067\u3082\u6295\u3052\u59CB\u3081\u307E\u3057\u305F"
    Timelapses:
    - languageEnum: 0
