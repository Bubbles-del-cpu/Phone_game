    Character: {fileID: 11400000, guid: 7bd5d83a9443f8449b2f8346c4479558, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: When the alarm went off and the boat tilted, Lisa ran
        for the door.
    - languageEnum: 1
      LanguageGenericType: "\u30A2\u30E9\u30FC\u30E0\u304C\u9CF4\u308A,\u30DC\u30FC\u30C8\u306F\u50BE\u3044\u305F\u3068\u304D,\u30EA\u30B5\u306F\u30C9\u30A2\u306B\u5411\u304B\u3063\u3066\u8D70\u308A\u51FA\u3057\u305F."
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
      LanguageGenericType: 
    Timelapse: 
    Duration: 2
    Delay: 0
