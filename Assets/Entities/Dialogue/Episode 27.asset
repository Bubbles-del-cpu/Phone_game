  - NodeGuid: 2bb698b8-9ce9-41e2-89ae-02b6481c2d09
    Position: {x: 29050, y: 0}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 6323b46c77e31894982815cddd266d24, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I do a small viewing at the end of every season. Fifteen,
        twenty people.
    - languageEnum: 1
      LanguageGenericType: "\u56DB\u5B63\u6298\u3005\u306E\u7AEF\u306B\u5C0F\u3055\u306A\u666F\u8272\u3092\u773A\u3081\u307E\u3059\u3002
        15\u540D\u300120\u540D"
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
      LanguageGenericType: 
    Timelapse: 
    Duration: 2
    Delay: 0
    MediaType: 0
