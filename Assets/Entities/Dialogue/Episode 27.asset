    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: And I want her standing next to it when they look at it
    - languageEnum: 1
      LanguageGenericType: "\u305D\u3057\u3066\u3001\u305D\u306E\u6A2A\u306B\u7ACB\u3063\u3066\u307F\u308B\u3068\u3001"
