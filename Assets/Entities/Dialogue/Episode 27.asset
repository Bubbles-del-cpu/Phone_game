    DelayTimer: 0
  - NodeGuid: 65708619-bd8f-4c88-9532-c7e0bfec49f4
    Position: {x: 29400, y: 0}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 6323b46c77e31894982815cddd266d24, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I want the class in first though. Six o'clock, before
        the doors open.
    - languageEnum: 1
      LanguageGenericType: "\u307E\u305A\u306F\u30AF\u30E9\u30B9\u3092\u3057\u305F\u3044\u3002
        \u30C9\u30A2\u304C\u958B\u304F\u524D\u306B\u30016\u6642\u6642\u8A08\u3002"
