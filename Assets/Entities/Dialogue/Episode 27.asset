    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: And she'll be here until the last glass is washed
    - languageEnum: 1
      LanguageGenericType: "\u305D\u3057\u3066\u3001\u6700\u5F8C\u306E\u30AC\u30E9\u30B9\u304C\u6D17\u6D44\u3055\u308C\u308B\u307E\u3067\u3053\u3053\u306B\u3042\u308A\u307E\u3059"
