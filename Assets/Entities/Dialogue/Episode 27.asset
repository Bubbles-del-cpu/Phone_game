    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Either way nobody gets anything you didn't say yes to
    - languageEnum: 1
      LanguageGenericType: "\u3069\u3061\u3089\u306E\u65B9\u6CD5\u3067\u8AB0\u3082\u3042\u306A\u305F\u304C\u305D\u3046\u8A00\u308F\u306A\u304B\u3063\u305F\u4F55\u3082\u53D6\u5F97\u3057\u307E\u305B\u3093"
