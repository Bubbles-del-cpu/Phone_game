    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 6323b46c77e31894982815cddd266d24, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: They were in the room. They're the only people alive who
        saw the real thing.
    - languageEnum: 1
      LanguageGenericType: "\u304A\u90E8\u5C4B\u306B\u3042\u308A\u307E\u3057\u305F\u3002
        \u5B9F\u7269\u3092\u898B\u3066\u3044\u308B\u4EBA\u3060\u3051\u304C\u751F\u304D\u3066\u308B\u3093\u3067\u3059\u3002"
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
      LanguageGenericType: 
