    - languageEnum: 1
      LanguageGenericType: "\u5C11\u5E74\u3060\u3063\u305F\u3068\u601D\u3063\u305F\u4E8B\u30673\u65E5\u3092\u5E73\u3089\u306B\u904E\u3054\u3057\u307E\u3057\u305F"
