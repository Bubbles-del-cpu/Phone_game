    GalleryVisibility: 0
    Post: {fileID: 0}
    DelayTimer: 0
  - NodeGuid: 19e55767-2548-4ab0-b6c4-3f92822ad2dc
    Position: {x: 27650, y: 0}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 6323b46c77e31894982815cddd266d24, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: The painting goes on the wall. And your wife stands next
        to it.
    - languageEnum: 1
      LanguageGenericType: "\u7D75\u753B\u306F\u58C1\u306B\u884C\u304D\u307E\u3059\u3002
        \u305D\u3057\u3066\u3001\u3042\u306A\u305F\u306E\u59BB\u306F\u305D\u308C\u306E\u96A3\u306B\u7ACB\u3063\u3066\u3044\u307E\u3059\u3002"
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
