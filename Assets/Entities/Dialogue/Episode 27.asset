    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: If he goes home it's me and her, and there's something
        she wants to ask you first
    - languageEnum: 1
      LanguageGenericType: "\u5F7C\u304C\u5BB6\u306B\u884C\u304F\u306A\u3089\u3001\u305D\u308C\u306F\u79C1\u3068\u5F7C\u5973\u3067\u3059\u3001\u305D\u3057\u3066\u5F7C\u5973\u306F\u6700\u521D\u306B\u3042\u306A\u305F\u306B\u5C0B\u306D\u305F\u3044\u3082\u306E\u304C\u3042\u308A\u307E\u3059"
