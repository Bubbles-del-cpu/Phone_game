    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: If he doesn't, she's alone with me
    - languageEnum: 1
      LanguageGenericType: "\u3082\u3057\u305D\u3046\u3067\u306A\u3051\u308C\u3070\u3001\u5F7C\u5973\u306F\u79C1\u3068\u4E00\u4EBA\u3067\u3044\u308B"
