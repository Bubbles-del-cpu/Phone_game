    - languageEnum: 1
      LanguageGenericType: "\u305D\u3057\u3066\u4ECA\u3001\u5F7C\u3089\u306F\u305D\u308C\u3092\u898B\u3066\u3044\u308B\u5F7C\u3089\u306E\u30D0\u30FC\u30B8\u30E7\u30F3\u3092\u898B\u3066\u3044\u307E\u3059"
