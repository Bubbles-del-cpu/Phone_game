    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: You should be proud of her tonight. I mean that.
    - languageEnum: 1
      LanguageGenericType: "\u5FB9\u591C\u3092\u8A87\u308A\u306B\u601D\u3044\u307E\u3059\u3002
