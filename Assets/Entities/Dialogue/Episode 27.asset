      LanguageGenericType: "\u3057\u304B\u3057\u3001\u6700\u5F8C\u306E\u6905\u5B50\u304C\u30B9\u30BF\u30C3\u30AF\u3055\u308C\u308B\u307E\u3067\u3053\u3053\u306B\u3044\u308B"
