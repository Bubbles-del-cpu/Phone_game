  - NodeGuid: 1421d54c-c740-40f0-b8cf-d87a80af5954
    Position: {x: 27300, y: 0}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 6323b46c77e31894982815cddd266d24, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: The class first, at six. Then whoever turns up off the
        street at seven.
    - languageEnum: 1
      LanguageGenericType: "\u307E\u305A\u306F6\u30AF\u30E9\u30B9\u3002 \u305D\u306E\u5F8C\u30017\u968E\u306E\u901A\u308A\u3092\u8131\u3044\u3067\u3044\u307E\u3059\u3002"
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
      LanguageGenericType: 
