  - NodeGuid: 04f7ed41-e160-43f9-85e2-d738ba186617
    Position: {x: 191800, y: 0}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 6323b46c77e31894982815cddd266d24, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: If he stays, she gets a man who has wanted her since the
        day she took her robe off in my studio
    - languageEnum: 1
      LanguageGenericType: "\u5F7C\u304C\u6EDE\u5728\u3057\u305F\u3089\u3001\u5F7C\u5973\u306F\u79C1\u306E\u30B9\u30BF\u30B8\u30AA\u3067\u5F7C\u5973\u306E\u30ED\u30FC\u30D6\u3092\u53D6\u3063\u305F\u65E5\u4EE5\u6765\u3001\u5F7C\u5973\u3092\u671B\u3093\u3067\u3044\u305F\u7537\u3092\u53D6\u5F97\u3057\u307E\u3059"
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
      LanguageGenericType: 
