    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: So at some point tonight it's the three of us in an empty
        room
    - languageEnum: 1
      LanguageGenericType: "\u305D\u3053\u3067\u3001\u4ECA\u591C\u306F\u7A7A\u5BA4\u30673\u4EBA\u306E\u79C1\u305F\u3061\u3067\u3059\u3002"
