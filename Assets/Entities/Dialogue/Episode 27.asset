  - NodeGuid: b2c1f4ed-dca7-4c24-82c7-252153a45a2b
    Position: {x: 196000, y: 0}
    DialogueNodePorts: []
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
