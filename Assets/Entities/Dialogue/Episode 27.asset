    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    Character: {fileID: 11400000, guid: 6323b46c77e31894982815cddd266d24, type: 2}
    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: I'm doing a viewing tonight. Small one, end of season.
    - languageEnum: 1
      LanguageGenericType: "\u591C\u3092\u773A\u3081\u308B\u3064\u3082\u308A\u3067\u3059\u3002
        \u5B63\u7BC0\u9650\u5B9A\u306E\u5C0F\u3055\u30581\u672C\u3002"
    Timelapses:
    - languageEnum: 0
      LanguageGenericType: 
    - languageEnum: 1
