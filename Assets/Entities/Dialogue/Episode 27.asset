    - languageEnum: 1
      LanguageGenericType: "\u591C\u4E2D\u591C\u306B\u81EA\u5206\u3067\u6C7A\u3081\u308B\u3088\u308A\u3082\u3001\u4ECA\u306E\u3068\u3053\u308D\u4F55\u3092\u6C7A\u307E\u3063\u3066\u3044\u308B\u306E\u304B"
