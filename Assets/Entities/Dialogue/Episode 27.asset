    - languageEnum: 1
      LanguageGenericType: "\u305D\u3057\u3066\u3001\u305D\u308C\u306F\u79C1\u304C\u6210\u9577\u3057\u305F\u7537\u3068\u5168\u4F53\u306E\u6642\u9593\u3092\u6271\u3046\u3057\u3066\u304D\u305F\u3053\u3068"
