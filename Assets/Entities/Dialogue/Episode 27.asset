    AvatarPos: 0
    AvatarType: 0
    Texts:
    - languageEnum: 0
      LanguageGenericType: Before you answer, understand what you're choosing between
    - languageEnum: 1
      LanguageGenericType: "\u3042\u306A\u305F\u304C\u7B54\u3048\u308B\u524D\u306B\u3001\u3042\u306A\u305F\u304C\u9078\u3076\u3082\u306E\u3092\u7406\u89E3\u3057\u307E\u3059"
